Algoritmo SalarioEmpleado
	Definir numeroHoras, valorHora, salarioPagar Como Real
	Escribir "Ingresa el numero de horas trabajadas"
	Leer numeroHoras
	Escribir "Ingresa el valor por hora"
	Leer valorHora
	salarioPagar = numeroHoras*valorHora
	Escribir "El salario a pagar es ", salarioPagar
FinAlgoritmo
