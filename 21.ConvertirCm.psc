Algoritmo ConvertirCm
	Definir cm, yar, mt, ps, pg Como Real
	Escribir "Ingrese el valor en centimetros"
	leer cm
	yar = cm/91.44
	mt = cm/100
	ps = cm/30.48
	pg = cm/2.54
	Escribir "El valor ingresado en: "
	Escribir "Yardas es: ", yar
	Escribir "Metros es: ", mt
	Escribir "Pies es: ", ps
	Escribir "Pulgadas es: ", pg
FinAlgoritmo
