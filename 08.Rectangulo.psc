Algoritmo Rectangulo
	Definir b, al, ar, p como real
	Escribir "Ingrese la base del rectangulo: "
	Leer b
	Escribir "Ingrese la altura del rectangulo: "
	Leer al
	ar = b*al
	p = 2*(b+al)
	Escribir "El area del rectangulo  es: ", ar
	Escribir "El perimetro del rectangulo es: ", p
	
FinAlgoritmo
