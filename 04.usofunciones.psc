Algoritmo UsoFunciones
	Definir num, seno, coseno, tangente Como Real
	Definir raizz, logaritmoNatural, logaritmo10 Como Real
	Escribir "Ingrese un numero: "
	Leer num
	
	seno = sen(num)
	coseno = cos(num)
	tangente = tan(num)
	raizz = raiz(num)
	logaritmoNatural = Ln(num)
	logaritmo10 = Ln(num)/ln(10)
	Escribir "Del nuemro ", num
	Escribir "Su seno es ", seno
	Escribir "Su coseno es ", coseno
	Escribir "Su tangente es " tangente
	Escribir "Su raiz cuadrada es " raizz
	Escribir "Su logaritmo natural es " logaritmoNatural
	Escribir "Su logaritmo 10 es " logaritmo10
FinAlgoritmo
