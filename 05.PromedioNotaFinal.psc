Algoritmo PromedioNotaFinal
	Definir n1, n2, n3, n4, nf Como Real
	Escribir "Ingrese la nota 1"
	Leer n1
	Escribir "Ingrese la nota 2"
	Leer n2
	Escribir "Ingrese la nota 3"
	Leer n3
	Escribir "Ingrese la nota 4"
	Leer n4
	nf = (n1+n2+n3+n4)/4
	Escribir "La Nota definitva es " nf
FinAlgoritmo
